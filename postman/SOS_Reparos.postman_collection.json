              "body": "{\n  \"dados\": {\n    \"id\": 1,\n    \"tipo_servico\": \"Desentupimento\",\n    \"descricao\": \"Pia da cozinha entupida há dois dias.\",\n    \"endereco\": \"Rua das Flores, 123 – Belo Horizonte/MG\",\n    \"status\": \"PENDENTE\",\n    \"criado_em\": \"2026-05-11T21:00:00.000Z\",\n    \"atualizado_em\": \"2026-05-11T21:00:00.000Z\",\n    \"usuario_nome\": \"João Silva\",\n    \"usuario_email\": \"joao@email.com\",\n    \"usuario_telefone\": \"31999990001\",\n    \"prestador_nome\": null,\n    \"prestador_email\": null,\n    \"prestador_telefone\": null,\n    \"prestador_especialidade\": null\n  }\n}"
            },
