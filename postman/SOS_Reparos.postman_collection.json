            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"usuario_id\": 1,\n  \"tipo_servico\": \"Desentupimento\",\n  \"descricao\": \"Pia da cozinha entupida há dois dias, água não escoa.\",\n  \"endereco\": \"Rua das Flores, 123 – Belo Horizonte/MG\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/solicitacoes",
              "host": ["{{base_url}}"],
              "path": ["solicitacoes"]
            },
            "description": "Cria uma nova solicitação de serviço hidráulico. Status inicial: PENDENTE."
          },
          "response": [
            {
              "name": "201 Created",
              "status": "Created",
              "code": 201,
              "originalRequest": {
                "method": "POST",
                "url": { "raw": "{{base_url}}/solicitacoes" }
              },
              "body": "{\n  \"mensagem\": \"Solicitação criada com sucesso.\",\n  \"dados\": {\n    \"id\": 1,\n    \"usuario_id\": 1,\n    \"prestador_id\": null,\n    \"tipo_servico\": \"Desentupimento\",\n    \"descricao\": \"Pia da cozinha entupida há dois dias, água não escoa.\",\n    \"endereco\": \"Rua das Flores, 123 – Belo Horizonte/MG\",\n    \"status\": \"PENDENTE\",\n    \"criado_em\": \"2026-05-11T21:00:00.000Z\",\n    \"atualizado_em\": \"2026-05-11T21:00:00.000Z\"\n  }\n}"
            },
            {
              "name": "422 Dados inválidos",
              "status": "Unprocessable Entity",
              "code": 422,
              "originalRequest": {
                "method": "POST",
                "url": { "raw": "{{base_url}}/solicitacoes" }
              },
              "body": "{\n  \"erro\": \"Dados inválidos.\",\n  \"detalhes\": [\n    { \"campo\": \"descricao\", \"mensagem\": \"descricao deve ter pelo menos 10 caracteres.\" }\n  ]\n}"
            }
          ]
